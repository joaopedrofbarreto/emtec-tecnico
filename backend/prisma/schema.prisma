// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Servico {
  id        String  @id @default(uuid())
  codigo    Int     @unique
  nome      String
  valorBase Decimal
}

model Categoria {
  id        String  @id @default(uuid())
  codigo Int    @unique
  nome   String
}

model Regiao {
  id        String  @id @default(uuid())
  codigo     Int     @unique
  nome       String
  fatorPreco Decimal
}

model FaixaUtilizacao {
  id        String  @id @default(uuid())
  quantidadeInicial Int
  quantidadeFinal   Int?
  acrescimo         Decimal
}

model Regra {
  id        String  @id @default(uuid())
  nome       String
  prioridade Int
  ativa      Boolean  @default(true)
  condicoes  Json
  acao       Json
  criadaEm   DateTime @default(now())
}